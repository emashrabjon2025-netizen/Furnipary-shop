rules_version = '2';

// FURNIPART — Firestore himoya qoidalari.
// Firebase Console → Firestore Database → Rules bo'limiga to'liq nusxa qilib "Publish" bosing.
// Admin — Firebase Authentication'dagi UID (js/config.js dagi ADMIN_UIDS bilan bir xil).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['B3O0Gn3vA3al6kmBZw5porxAEXC3'];
    }

    // Mahsulotlarni hamma ko'radi, faqat admin o'zgartiradi
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Katta rasmlar
    match /productImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Operator — admin qo'shgan va faol xodim (crmOperators/<uid>)
    function isOperator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/crmOperators/$(request.auth.uid))
        && get(/databases/$(database)/documents/crmOperators/$(request.auth.uid)).data.active == true;
    }

    // Kuryer (dastavka) — admin qo'shgan va faol xodim (crmCouriers/<uid>)
    function isCourier() {
      return request.auth != null
        && exists(/databases/$(database)/documents/crmCouriers/$(request.auth.uid))
        && get(/databases/$(database)/documents/crmCouriers/$(request.auth.uid)).data.active == true;
    }

    // Matras sotuvchisi — admin qo'shgan va faol xodim (crmMatras/<uid>)
    function isMatras() {
      return request.auth != null
        && exists(/databases/$(database)/documents/crmMatras/$(request.auth.uid))
        && get(/databases/$(database)/documents/crmMatras/$(request.auth.uid)).data.active == true;
    }

    // Matras mijozlari bazasi — admin va matras sotuvchilari (o'chirish faqat admin)
    match /matrasClients/{id} {
      allow read, write: if isAdmin();
      allow read, create, update: if isMatras();
    }
    match /crmMatras/{uid} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // CRM: admin hammasini ko'radi; operator faqat o'ziga biriktirilgan lidlarni
    match /crmLeads/{id} {
      allow read, write: if isAdmin();
      allow read: if isOperator() && resource.data.assignedTo == request.auth.uid;
      allow update: if isOperator()
        && resource.data.assignedTo == request.auth.uid
        && request.resource.data.assignedTo == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'nextCall', 'note', 'attempts', 'lastAttemptAt', 'attemptLog', 'contactedAt', 'lostReason', 'lostNote', 'lostDate', 'soldAmount', 'soldAt', 'updatedAt', 'region']);
    }
    match /crmClients/{id} { allow read, write: if isAdmin(); }
    match /crmSales/{id} {
      allow read, write: if isAdmin();
      allow read: if isOperator() && resource.data.operator == request.auth.uid;
      allow create: if isOperator() && request.resource.data.operator == request.auth.uid;
      allow read: if isCourier() && resource.data.courier == request.auth.uid;
      allow create: if isCourier() && request.resource.data.courier == request.auth.uid && request.resource.data.paid == 0;
      allow read: if isMatras() && resource.data.seller == request.auth.uid;
      allow create: if isMatras() && request.resource.data.seller == request.auth.uid && request.resource.data.category == 'matras';
      allow update: if isCourier()
        && resource.data.courier == request.auth.uid
        && request.resource.data.courier == request.auth.uid
        && request.resource.data.status in ['Yangi', 'Tayyorlanmoqda', "Yo'lda", 'Yetkazildi']
        && request.resource.data.get('paid', 0) >= resource.data.get('paid', 0)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paid', 'collected', 'deliveredAt', 'deliveryDate', 'courierNote', 'deliveryLog', 'updatedAt', 'area']);
    }
    match /crmSettings/{id} {
      allow read, write: if isAdmin();
      allow read: if id == 'scripts' && isOperator();
      allow read, write: if id == 'cities' && isCourier();
      allow read: if id == 'matras' && isMatras();
    }
    match /crmCouriers/{uid} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /crmOperators/{uid} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Sayt: chat, bildirishnoma obunalari va navbati — faqat admin (mijozlar server orqali yozadi)
    match /siteChats/{id} { allow read, write: if isAdmin(); }
    match /pushSubs/{id} { allow read, write: if isAdmin(); }
    match /pushQueue/{id} { allow read, write: if isAdmin(); }

    // Buyurtmalar: mijoz faqat yangi buyurtma yarata oladi, ko'rish/o'zgartirish — faqat admin
    match /orders/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'phone', 'address', 'comment', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+998[0-9]{9}$')
        && request.resource.data.address is string && request.resource.data.address.size() <= 120
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 300
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.status == 'Yangi'
        && request.resource.data.createdAt == request.time;
    }
  }
}
